<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="NpgSQL Nightly" value="https://www.myget.org/F/npgsql-vnext/api/v3/index.json" />
		<add key="davidfowl-aspire" value="https://f.feedz.io/davidfowl/aspire/nuget/index.json" />
        <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="NpgSQL Nightly">
			<package pattern="Npgsql.EntityFrameworkCore.PostgreSQL" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
			<package pattern="Npgsql.EntityFrameworkCore.PostgreSQL" />
		</packageSource>
		<packageSource key="davidfowl-aspire">
			<package pattern="Aspire.Hosting.Docker.SshDeploy" />
		</packageSource>
        <packageSource key="dotnet11">
            <package pattern="*" />
        </packageSource>
	</packageSourceMapping>
</configuration>