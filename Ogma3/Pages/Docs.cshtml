@page "{slug}"
@model Docs

@{
	ViewData["Title"] = Model.Document.Title;
	var maxVersion = Model.Versions.Select(v => v.Version).Max();
	var digits = (int)Math.Abs(Math.Log(maxVersion, 10)) + 1;
}

<article class="document">
	<h1 class="header olde">@Model.Document.Title</h1>

	@if (Model.Document.Headers.Any())
	{
		<div class="toc">
			@foreach (var h in Model.Document.Headers)
			{
				<a href="#@h.Id" class="toc-h @("h" + h.Level)">
					@h.Body
				</a>
			}
		</div>
	}

	@if (Model.Document.CustomCss is {} css)
	{
		<style asp-add-nonce="true">
			@Html.Raw(css)
		</style>
	}

	<div class="md">
		@Html.Raw(Model.Document.CompiledBody)
	</div>

	@if (Model.Document.CustomJs is {} js)
	{
		<script asp-add-nonce="true">
			@Html.Raw(js)
		</script>
	}

	<details class="details">
		<summary>Version history</summary>
		<ul class="my-list">
			@foreach (var ver in Model.Versions)
			{
				<li class="item tabular">
					<a asp-page="/Docs" asp-route-v="@ver.Version" asp-route-slug="@ver.Slug">
						version @ver.Version.ToString($"D{digits}") — <time-display utc-date="ver.CreationTime" formatter="@(d => d.ToString("yyyy-MM-dd HH:mm:ss"))"></time-display>
					</a>
					@if (ver.Version == Model.Document.Version)
					{
						<span class="current">current</span>
					}
					else
					{
						<doc-diff
							slug="@Model.Document.Slug"
							current-version="@Model.Document.Version"
							target-version="@ver.Version"
							body-selector="article .md">
						</doc-diff>
					}
				</li>
			}
		</ul>
	</details>
</article>

@section Scripts {
	<script src="~/js/comp/doc-diff.js" asp-append-version="true" type="module"></script>
}