@page
@using Ogma3.Infrastructure.Extensions
@using Routes.Pages
@model Ogma3.Pages.Chapters.RestoreModel
@{
    ViewData["Title"] = "Restore Chapter";
    var route = User_Stories.Get(User.GetUsername() ?? "");
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
        <p><a for-route="route" class="btn btn-primary">Back to My Stories</a></p>
    }
    else if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>

        if (Model.RestoredChapterId is {} cid && Model.RestoredStoryId is {} sid)
        {
            var chapterRoute = Chapter.Get(sid, cid, null);
            <p><a for-route="chapterRoute" class="btn btn-primary">View Chapter</a></p>
        }
        else if (Model.RestoredStoryId is {} sid2)
        {
            var storyRoute = Story.Get(sid2, null);
            <p><a for-route="storyRoute" class="btn btn-primary">Back to Story</a></p>
        }
        else
        {
            <p><a for-route="route" class="btn btn-primary">Back to My Stories</a></p>
        }
    }
    else
    {
        <div class="alert alert-info">
            Restore "@Model.ContentTitle"? It will become visible again immediately.
        </div>
        <form method="post">
            <input type="hidden" asp-for="Token" />
            <button type="submit" class="btn btn-primary">Restore Chapter</button>
        </form>
    }
</div>