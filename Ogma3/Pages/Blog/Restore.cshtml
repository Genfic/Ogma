@page
@using Ogma3.Infrastructure.Extensions
@using Routes.Pages
@model Ogma3.Pages.Blog.RestoreModel
@{
    ViewData["Title"] = "Restore Blog Post";
    var route = User_Blog.Get(User.GetUsername() ?? "");
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
        <p><a for-route="route" class="btn btn-primary">Back to My Blog</a></p>
    }
    else if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>

        if (Model.RestoredBlogpostId is {} bid)
        {
            var blogRoute = Blog_Post.Get(bid, null);
            <p><a for-route="blogRoute" class="btn btn-primary">View Blog Post</a></p>
        }
        else
        {
            <p><a for-route="route" class="btn btn-primary">Back to My Blog</a></p>
        }
    }
    else
    {
        <div class="alert alert-info">
            Restore "@Model.ContentTitle"? It will become visible again immediately.
        </div>
        <form method="post">
            <input type="hidden" asp-for="Token" />
            <button type="submit" class="btn btn-primary">Restore Blog Post</button>
        </form>
    }
</div>