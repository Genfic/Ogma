@page
@model DeletePersonalDataModel
@{
	ViewData["Title"] = "Delete Personal Data";
	ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="alert alert danger" role="alert">
	<p>
		<strong>Deleting this data will permanently remove your data, and this cannot be recovered.</strong>
	</p>
</div>

<div class="alert alert warning">
	<p>This could take a while, the page might hang for a moment</p>
</div>

<div>
	<form id="delete-user" method="post" class="form" autocomplete="off">
		<div asp-validation-summary="All" class="text-danger"></div>

		<p>You will first be asked to verify your credentials before the deletion is carried out.</p>

		<div class="o-form-group">
			<button class="btn btn-danger" type="submit">Delete data and close my account</button>
		</div>

	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial"/>
}