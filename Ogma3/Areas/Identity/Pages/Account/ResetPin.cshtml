@page "/reset-pin"
@model ResetPinModel
@{
	ViewData["Title"] = "Reset PIN";
}

<h1 class="olde">@ViewData["Title"]</h1>

@if (Model.Success)
{
	<h2>Success!</h2>

	<p>
		An e-mail with reset link has been sent, and will be valid for the next hour.
	</p>
}
else
{
	<h2>Are you sure you want to reset your PIN?</h2>

	<p>
		For safety reasons, you will not be able to delete your content for 24 hours after resetting the PIN. Consider unpublishing it instead in the interim.
	</p>

	<p>
		After clicking the button below, you will receive an e-mail with a reset link.
	</p>

	<form method="post" class="form">
		<button type="submit" class="btn btn-primary">Reset my PIN</button>
	</form>
}