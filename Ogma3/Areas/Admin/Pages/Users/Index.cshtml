@page
@using Routes.Areas.Admin.Pages
@model Ogma3.Areas.Admin.Pages.Users.Index

@{
	ViewData["Title"] = "Users";
	ViewData["ActivePage"] = NavPages.Users;
}

<a for-route="@Users_Create.Get()" class="btn btn-primary">Create</a>

<form class="search form" method="GET" for-route="@Users_Details.Get(null)">
	<div class="form-row">
		<div class="o-form-group">
			<label for="username">Search</label>
			<input class="active-border"
			       id="username"
			       list="autocomplete"
			       name="name"
			       autocomplete="off"
			       type="search">
			<datalist id="autocomplete"></datalist>
		</div>

		<input class="btn btn-primary w-3" type="submit" value="Go">
	</div>
</form>

<table class="o-table wide">
	<thead>
	<tr>
		<th>ID</th>
		<th>Name</th>
		<th>Joined</th>
		<th title="stories">S</th>
		<th title="chapters">C</th>
		<th title="blogposts">B</th>
		<th>Active</th>
		<th>Actions</th>
	</tr>
	</thead>
	<tbody>
	@foreach (var u in Model.Users)
	{
		<tr>
			<td class="right">@u.Id</td>
			<td>@u.Name</td>
			<td>@u.Joined.ToString("yyy-MM-dd HH:mm")</td>
			<td class="right">@u.Stories</td>
			<td class="right">@u.Chapters</td>
			<td class="right">@u.Blogposts</td>
			<td>@u.Active</td>
			<td>
				<a for-route="@Users_Details.Get(u.Name)">Details</a>
				<a for-route="@Routes.Pages.User_Index.Get(u.Name)">Profile</a>
			</td>
		</tr>
	}
	</tbody>
</table>

<partial name="_Pagination" model="@Model.Pagination"/>

@section Scripts {
	<script type="module" src="~/js/admin/user-search.js" asp-append-version="true"></script>
}