@page
@using Ogma3.Data.Reports
@model Reports

@{
	ViewData["Title"] = "Reports";
	ViewData["ActivePage"] = NavPages.Reports;
}

<table class="o-table">
	<tr>
		<th>ID</th>
		<th>Item</th>
		<th>Reporter</th>
		<th>Date</th>
		<th>Description</th>
		<th>Status</th>
	</tr>
	@foreach (var report in Model.ReportsList)
	{
		<tr>
			<td>@report.Id</td>
			<td>
				<a href="content/@report.ContentType/@report.ContentId">@report.ContentType</a>
			</td>
			<td>@report.ReporterUserName</td>
			<td>@report.ReportDate</td>
			<td>
				<markdown preset="Basic">@report.Reason</markdown>
			</td>
			<td>@report.Status.ToStringFast()</td>
		</tr>
	}
</table>

<partial name="_Pagination" model="Model.Pagination"/>