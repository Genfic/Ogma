@page
@using SafeRouting
@using static Routes.Areas.Admin.Pages.Scripts
@model Ogma3.Areas.Admin.Pages.Scripts

@{
	ViewData["Title"] = "Scripts";

	var scripts = new List<(string Text, IRouteValues Route)>()
	{
		("Update Stories (set `IsVisible` based on publish date nullability)", PostUpdateStories()),
		("Reload tag cache based on tags in the database", PostReloadTagCache()),
		("Recalculate blogpost excerpt cutoff points", PostRecalculateBlogpostCutoff()),
		("Migrate news blogposts to news proper", PostMigrateNewsPosts()),
		("Recalculate story chapter and word counts", PostRecalculateStoryCounts()),
	};
}

<pre>
@(Model.Message ?? "No message")
</pre>

<div class="scripts">

	@foreach (var (text, route) in scripts)
	{
		<form for-route="@route" method="post">
			<input type="submit" value="@text">
		</form>
	}

</div>

<style asp-add-nonce="true">
	.scripts {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: .25rem;

		input[type="submit"] {
			text-decoration: none;
			display: flex;
			padding: .5rem 1rem;
			background-color: var(--accent-5);
			border: 1px solid var(--accent-75);
			color: var(--foreground);
			font-family: "Inconsolata Variable", Consolas, Courier, monospace;

			&:hover {
				background-color: var(--accent-10);
				border-color: var(--accent);
			}
		}
	}
</style>