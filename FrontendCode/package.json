{
	"name": "ogma-3",
	"version": "beta",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"webtypes": "bun ./scripts/webtypes.ts",
		"lint": "bunx oxlint .",
		"lint:fix": "bunx oxlint . --fix",
		"format": "bunx oxfmt . --check",
		"format:fix": "bunx oxfmt .",
		"css": "bun ./scripts/build-sass.ts",
		"css:lint": "bunx stylelint '**/*.scss' -c stylelint.config.ts",
		"css:prod": "bun run css -- -c --no-size",
		"css:watch": "bun run css -- -wc",
		"js": "bun ./scripts/build-js.ts",
		"js:watch": "bun run js -- -wc",
		"js:prod": "bun run js -- -cr --no-size",
		"js:typecheck": "bun check -p ./typescript",
		"lh": "bunx unlighthouse"
	},
	"dependencies": {
		"@angius/htmldiff": "^2.0.1",
		"@angius/tinytime": "^1.2.0",
		"@atulin/html-sanitizer": "npm:@jsr/atulin__html-sanitizer@3.0.0",
		"@solid-primitives/destructure": "^0.2.4",
		"@solid-primitives/event-dispatcher": "^0.1.1",
		"@solid-primitives/intersection-observer": "^2.2.5",
		"@solid-primitives/scheduled": "^1.5.3",
		"@solid-primitives/storage": "^4.4.0",
		"clsx": "^2.1.1",
		"comlink": "^4.4.2",
		"es-toolkit": "^1.53.2",
		"hash-wasm": "^4.13.0",
		"marked": "^18.2.0",
		"sa11y": "^5.1.0",
		"solid-element": "^1.9.2",
		"solid-js": "^1.9.19",
		"solid-signals": "^1.9.1",
		"uqr": "^0.1.3",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@angius/bun-plugin-solid": "^1.5.0",
		"@commander-js/extra-typings": "^15.1.0",
		"@happy-dom/global-registrator": "^21.0.4",
		"@parcel/watcher": "^2.6.0",
		"@socketsecurity/bun-security-scanner": "^1.1.3",
		"@stylelint-types/stylelint-scss": "^7.0.1",
		"@types/ansi-colors": "^3.2.6",
		"@types/bun": "^1.4.4",
		"@types/ejs": "^3.1.5",
		"@types/json5": "^2.2.0",
		"@types/node": "^26.6.6",
		"chalk": "^6.0.1",
		"chalk-template": "^1.1.3",
		"cheerio": "^1.2.0",
		"commander": "^15.1.0",
		"convert": "^8.1.0",
		"esbuild": "^0.28.2",
		"lighthouse": "^13.6.0",
		"lightningcss": "^1.33.0",
		"oxc-parser": "^0.157.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"sass-embedded": "^1.108.2",
		"solid-labels": "^0.17.1",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0",
		"stylelint-config-standard-scss": "^18.0.0",
		"typescript": "^7.0.2",
		"utility-types": "^3.11.0"
	},
	"web-types": [
		"./web-types.json"
	],
	"webtypesConfig": {
		"name": "Ogma Components",
		"version": "1.0.0",
		"framework": "solid",
		"description-markup": "markdown"
	}
}
